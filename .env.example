OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
GITHUB_TOKEN=

# Auth.js (GitHub OAuth) — required to add/retake trainer mugshots
# Create an OAuth App: https://github.com/settings/developers
# Homepage URL: http://localhost:3000  (or your deploy URL)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
#   Production: https://YOUR_DOMAIN/api/auth/callback/github
AUTH_SECRET=          # e.g. openssl rand -base64 32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# AUTH_URL=http://localhost:3000   # optional; Auth.js usually infers host

# Remote Cloudflare D1 (optional). Without these, next dev uses data/commitdex.local.sqlite.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=   # accepted as an alias of CLOUDFLARE_API_TOKEN
# COMMITDEX_SQLITE_PATH= # optional override for the local SQLite file

# Optional trainer mugshot storage (photobooth). Prefer R2 when set; otherwise:
# - no D1 credentials → files under data/photos/ (served via /api/trainer/photo/[user])
# - remote D1 without R2 → compressed JPEG/WebP base64 in D1 photo_data (keep under ~300KB)
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=           # e.g. https://pub-xxxx.r2.dev or custom domain
# CLOUDFLARE_R2_TOKEN=          # optional; falls back to CLOUDFLARE_API_TOKEN
